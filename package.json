  },
  "homepage": "https://github.com/wavesplatform/js-test-env#readme",
  "dependencies": {
    "@waves/node-api-js": "1.4.0-snapshot.3",
    "@waves/ride-js": "^2.3.0",
    "@waves/ts-types": "^1.3.1",
    "@waves/waves-transactions": "^5.0.0",
    "chai": "^6.2.2",
    "chai-as-promised": "^8.0.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
